# ==========================================
# KinetiX 宣传片：混沌与秩序 (1080p Cinema)
# ==========================================

Define Style("cinematic"):
  layer: 0
  transition: "crossfade", dur: 2.4s

Define Style("text_hero"):
  layer: 2

# 素材声明
[bgm]:        test_assets/bgm_epic.mp3

[v_chaos]:    test_assets/v_chaos.mp4 [dark, abstract]
[v_order]:    test_assets/v_order.mp4 [tech, geometric]
[logo]:       test_assets/logo.png [overlay]

# 文字卡片 — 中英双语，居中显示
[t1]: text("告别鼠标拖拽，纯代码剪大片\nGoodbye drag-and-drop, hello code-first", font: songti, size: 56, bg_opacity: 0.0, color: "#FFFFFF", stroke_width: 2, stroke_color: "#00000060")
[t2]: text("不搞凭空生成，用逻辑控时间\nNo AI magic — pure logic-driven timelines", font: songti, size: 56, bg_opacity: 0.0, color: "#FFFFFF", stroke_width: 2, stroke_color: "#00000060")
[t3]: text("彻底摒弃界面，重塑极客体验\nDitch the GUI, embrace hacker workflows", font: songti, size: 56, bg_opacity: 0.0, color: "#FFFFFF", stroke_width: 2, stroke_color: "#00000060")
[t4]: text("KinetiX\n 视频界的 LaTeX\n The LaTeX of Video", font: heiti, size: 60, bg_opacity: 0.0, color: "#00FFCC", stroke_width: 2, stroke_color: "#00000060")

# --- 时间线编排 ---

[bgm] @ 00:00 | role: bgm | volume: -10 | trim_start: 24s | duration: 16s | fadein: 1s | fadeout: 3s

# 第一幕：混沌 (0–7.5s)
[v_chaos] @ 00:00 | style: "cinematic" | mute: true | duration: 7.5s
[t1]      @ 1s    | style: "text_hero"  | duration: 3s   | anchor: (0, 0)
[t2]      @ 4.5s  | style: "text_hero"  | duration: 3s   | anchor: (0, 0)

# 第二幕：秩序 (start=5.1s, 与混沌重叠 2.4s 实现柔滑过渡)
[v_order] @ v_chaos.end - 2.4s | style: "cinematic" | mute: true | duration: 7.5s
[t3]      @ 7.5s                | style: "text_hero"  | duration: 3s   | anchor: (0, 0)

# 第三幕：Logo 浮现 + 品牌曝光 (logo start=10.1s)
[logo] @ v_order.end - 2.5s | layer: 1 | duration: 5s   | anchor: (0, 0)
[t4]   @ v_order.end - 1.0s | layer: 2 | duration: 3.5s | pos: (50vw, 70vh)

# --- 关键帧 ---

[v_chaos]:
  scale: { 0s: 1.0, 7.5s: 1.12, curve: "ease_in" }

[v_order]:
  scale: { 0s: 1.15, 7.5s: 1.0, curve: "ease_out" }

[t1]:
  scale: { 0s: 0.85, 3s: 1.0, curve: "ease_out" }
  opacity: { 0s: 0.0, 0.6s: 1.0, 2.4s: 1.0, 3s: 0.0, curve: "ease_in_out" }

[t2]:
  scale: { 0s: 0.88, 3s: 1.0, curve: "ease_out" }
  opacity: { 0s: 0.0, 0.6s: 1.0, 2.4s: 1.0, 3s: 0.0, curve: "ease_in_out" }

[t3]:
  scale: { 0s: 0.9, 3s: 1.05, curve: "ease_in_out" }
  opacity: { 0s: 0.0, 0.6s: 1.0, 2.4s: 1.0, 3s: 0.0, curve: "ease_in_out" }

[t4]:
  opacity: { 0s: 0.0, 1.0s: 1.0, 2.7s: 1.0, 3.5s: 0.0, curve: "ease_in_out" }

[logo]:
  scale: { 0s: 0.22, 1.8s: 0.35, curve: "ease_out" }
  rotate: { 0s: -18, 1.8s: 0, curve: "ease_out" }
  opacity: { 0s: 0.0, 1.0s: 1.0, curve: "ease_out" }

Format: mp4, Res: 1080p, FPS: 30
